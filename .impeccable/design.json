    {
      "name": "EvaSelect",
      "kind": "input",
      "refersTo": "selector",
      "description": "Owner-drawn selector appearance. The native control owns popup sizing, keyboard behavior and wheel filtering.",
      "html": "<label class=\"ds-select-label\">Разрешение<span class=\"ds-select-wrap\"><select class=\"ds-select\" aria-label=\"Разрешение\"><option>1280 × 720</option><option selected>1920 × 1080</option><option>2560 × 1440</option><option>3840 × 2160</option></select><svg class=\"ds-select-chevron\" width=\"12\" height=\"10\" viewBox=\"0 0 12 10\" aria-hidden=\"true\"><path d=\"M2 3L6 7L10 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg></span></label>",
      "css": ".ds-select-label{display:grid;gap:8px;width:384px;max-width:100%;color:#d8cdb8;font:700 13.3333px \"Segoe UI\",sans-serif}.ds-select-wrap{position:relative;display:block}.ds-select{appearance:none;width:100%;height:29px;padding:0 42px 0 10px;border:0;border-radius:0;background:#1f1f1e;color:#d8cdb8;font:400 13.3333px \"Segoe UI\",sans-serif;cursor:default}.ds-select:hover{background:#1f1f1e}.ds-select:focus-visible{outline:1px dotted #d8cdb8;outline-offset:-4px}.ds-select option{background:#1f1f1e;color:#d8cdb8}.ds-select option:checked{background:#1a3dcc;color:#fff}.ds-select-chevron{position:absolute;right:13px;top:10px;pointer-events:none}"
    },
    {
      "name": "EvaSlider",
      "kind": "input",
      "refersTo": "slider",
      "description": "Slim rail, warm thumb and separate value label. This appearance sample does not reproduce native wheel routing or dynamic value formatting.",
      "html": "<label class=\"ds-slider-label\"><span class=\"ds-slider-heading\"><strong>Частота кадров</strong><span>60 FPS</span></span><input class=\"ds-slider\" type=\"range\" min=\"0\" max=\"2\" value=\"1\" aria-label=\"Частота кадров\"></label>",
      "css": ".ds-slider-label{display:grid;width:384px;max-width:100%;background:#0d0d0d;color:#d8cdb8;font:400 13.3333px \"Segoe UI\",sans-serif}.ds-slider-heading{display:flex;justify-content:space-between;min-height:25px}.ds-slider-heading strong{font-weight:700}.ds-slider{appearance:none;width:calc(100% - 16px);height:28px;margin:0 8px;border:0;background:transparent;cursor:pointer}.ds-slider::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:linear-gradient(to right,#2450e8 50%,#2d2d2b 50%)}.ds-slider::-webkit-slider-thumb{appearance:none;width:12px;height:12px;margin-top:-4px;border:0;border-radius:6px;background:#d8cdb8}.ds-slider::-moz-range-track{height:4px;border-radius:2px;background:#2d2d2b}.ds-slider::-moz-range-progress{height:4px;border-radius:2px;background:#2450e8}.ds-slider::-moz-range-thumb{width:12px;height:12px;border:0;border-radius:6px;background:#d8cdb8}.ds-slider:hover{background:transparent}.ds-slider:focus-visible{outline:1px dotted #d8cdb8;outline-offset:5px}"
    },
    {
      "name": "EvaToggle",
      "kind": "input",
      "refersTo": "toggle",
      "description": "CheckBox semantics with a pill track, readable label and visible focus. Native painting owns an opaque ink background and respects control bounds, clipping and translated graphics.",
      "html": "<label class=\"ds-toggle\"><input class=\"ds-toggle-input\" type=\"checkbox\" checked><span class=\"ds-toggle-text\">Плавное открытие панели</span><span class=\"ds-toggle-track\" aria-hidden=\"true\"></span></label>",
      "css": ".ds-toggle{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;width:384px;max-width:100%;height:42px;background:#0d0d0d;color:#d8cdb8;font:400 13.3333px \"Segoe UI\",sans-serif;cursor:pointer}.ds-toggle-input{position:absolute;opacity:0;width:1px;height:1px}.ds-toggle-text{flex:1}.ds-toggle-track{position:relative;flex:none;width:42px;height:22px;margin-right:2px;border-radius:11px;background:#464540}.ds-toggle-track::after{content:\"\";position:absolute;left:3px;top:3px;width:16px;height:16px;border-radius:8px;background:#d8cdb8}.ds-toggle-input:checked~.ds-toggle-track{background:#1a3dcc}.ds-toggle-input:checked~.ds-toggle-track::after{left:23px;background:#fff}.ds-toggle:hover .ds-toggle-track{filter:none}.ds-toggle-input:focus-visible~.ds-toggle-text::after{content:\"\";position:absolute;inset:1px;outline:1px dotted #d8cdb8;pointer-events:none}.ds-toggle-input:disabled~.ds-toggle-text{color:#a7a49a}"
    },
