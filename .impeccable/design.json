      "html": "<nav class=\"ds-tabs\" aria-label=\"Настройки\"><button class=\"ds-tab ds-tab-sources\">Источники</button><button class=\"ds-tab\" aria-current=\"page\">Видео</button><button class=\"ds-tab\">Аудио</button><button class=\"ds-tab\">Файлы</button><button class=\"ds-tab ds-tab-keys\">Клавиши</button></nav>",
      "css": ".ds-tabs{display:flex;gap:2px;width:404px;padding:12px 0;background:#0d0d0d}.ds-tab{flex:0 0 72px;height:32px;padding:0;border:0;border-radius:0;background:#0d0d0d;color:#d8cdb8;font:400 12px \"Segoe UI\",sans-serif;cursor:pointer}.ds-tab-sources{flex-basis:96px}.ds-tab-keys{flex-basis:84px}.ds-tab:hover{background:#2d2d2b}.ds-tab:active{background:#3b3b37}.ds-tab[aria-current=\"page\"]{background:#1a3dcc;color:#fff}.ds-tab[aria-current=\"page\"]:hover{background:#2450e8}.ds-tab[aria-current=\"page\"]:active{background:#0f2490}.ds-tab:focus-visible{outline:1px dotted currentColor;outline-offset:-4px}"
